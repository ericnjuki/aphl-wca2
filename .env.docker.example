# Copy this file to `.env` in the repo root. docker compose reads it automatically.
# NEVER commit the real `.env` — it's already in .gitignore.
#
# Prefer running `pnpm run deploy` instead of editing this by hand — it walks
# you through these values and writes `.env` for you.

# Required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=382ec773c7e92858f52ee112299e620901f449e051f8296f43e5afe7b74dc98e0c6b3412fce4637d556cf78905cae8b6

# Required — the public domain this deployment serves (no scheme, no path).
DOMAIN=labworkforce.online

# "own"      — the nginx container terminates TLS itself via certbot.
#              Build with: docker compose -f docker-compose.yml -f docker-compose.own-tls.yml up -d --build
#              Also set HTTP_PORT/HTTPS_PORT below if 80/443 are taken locally.
# "external" — TLS is already terminated by a reverse proxy on the host
#              (e.g. the box's system nginx, as with wca.ken-info.org). The
#              nginx container only serves plain HTTP on APP_PORT.
#              Build with: docker compose -f docker-compose.yml -f docker-compose.external.yml up -d --build
TLS_MODE=own

# TLS_MODE=own only — override if 80/443 are already taken on this host.
#HTTP_PORT=80
#HTTPS_PORT=443

# TLS_MODE=external only — the single host port the app is reachable on,
# which the host's own reverse proxy should proxy_pass to.
#APP_PORT=8888

# Comma-separated list of origins the API will accept. Should match how
# users actually reach the site, e.g. "https://labworkforce.online" or
# "https://wca.ken-info.org" — both deployments always sit behind HTTPS at
# the edge, even in TLS_MODE=external.
CORS_ORIGINS=https://labworkforce.online

# Session cookie — "true" is correct for both deployment modes, since users
# always reach the app over HTTPS at the edge. Only set to "false" during the
# brief TLS_MODE=own bootstrap window before a cert exists yet.
SESSION_COOKIE_SECURE=true

# Session lifetime in ms (default 8h).
SESSION_MAX_AGE_MS=28800000

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
