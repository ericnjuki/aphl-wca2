# Copy this file to `.env` in the repo root. docker compose reads it automatically.
# NEVER commit the real `.env` — it's already in .gitignore.
#
# Prefer running `pnpm run deploy` instead of editing this by hand — it walks
# you through these values and writes `.env` for you.

# Required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=382ec773c7e92858f52ee112299e620901f449e051f8296f43e5afe7b74dc98e0c6b3412fce4637d556cf78905cae8b6

# The public domain this deployment serves (no scheme, no path). Required
# for TLS_MODE=internal (used for cert paths + server_name). Optional for
# TLS_MODE=external — leave unset for a plain-HTTP deploy with no domain.
DOMAIN=example.com

# "internal" — the nginx container terminates TLS itself via certbot.
#              Build with: docker compose -f docker-compose.yml -f docker-compose.internal-tls.yml up -d --build
#              Also set HTTP_PORT/HTTPS_PORT below if 80/443 are taken locally.
# "external" — TLS is either already terminated by a reverse proxy elsewhere
#              on the host, or there's no TLS at all (plain HTTP only). The
#              nginx container only ever serves plain HTTP on APP_PORT.
#              Build with: docker compose -f docker-compose.yml -f docker-compose.external.yml up -d --build
TLS_MODE=internal

# TLS_MODE=internal only — override if 80/443 are already taken on this host.
#HTTP_PORT=80
#HTTPS_PORT=443

# TLS_MODE=external only — the single host port the app is reachable on,
# which the host's own reverse proxy (if any) should proxy_pass to.
#APP_PORT=8888

# Comma-separated list of origins the API will accept. Should match how
# users actually reach the site — e.g. "https://example.com" if there's
# HTTPS somewhere in front (TLS_MODE=internal, or TLS_MODE=external fronted
# by a proxy), or "http://<host-ip-or-name>:<APP_PORT>" for a genuine
# plain-HTTP deployment with no TLS anywhere.
CORS_ORIGINS=https://example.com

# Session cookie — "true" whenever the app is reached over HTTPS anywhere in
# front of it (TLS_MODE=internal once a cert exists, or TLS_MODE=external
# fronted by a proxy). Set to "false" during the brief TLS_MODE=internal
# bootstrap window before a cert exists yet, or for a genuine plain-HTTP
# deployment with no TLS anywhere.
SESSION_COOKIE_SECURE=true

# Session lifetime in ms (default 8h).
SESSION_MAX_AGE_MS=28800000

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
