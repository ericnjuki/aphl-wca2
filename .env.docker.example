# Copy this file to `.env` in the repo root. docker compose reads it automatically.
# NEVER commit the real `.env` — it's already in .gitignore.
#
# Prefer running `pnpm run deploy` instead of editing this by hand — it walks
# you through these values and writes `.env` for you.

# Required — docker compose refuses to start while this is empty. Generate one with:
#   openssl rand -hex 48
# or, where Node.js is installed:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Public host name of this server, e.g. "competency.example.org". Its DNS
# record must point at this server. Leave empty to run over plain HTTP only
# (local testing, or access by IP address).
DOMAIN=
# Optional extra host names on the same certificate, space-separated,
# e.g. "www.competency.example.org". Names added later are added to the
# certificate after `docker compose up -d`.
DOMAIN_ALIASES=
# Contact address registered with Let's Encrypt. Setting it (together with
# DOMAIN) makes the certbot service request a certificate, which accepts the
# Let's Encrypt Subscriber Agreement. nginx switches to HTTPS once it exists.
# Let's Encrypt no longer emails expiry warnings; use
# scripts/check-certificate.sh to watch the certificate instead.
LETSENCRYPT_EMAIL=

# Comma-separated list of origins the API will accept: the exact scheme and
# host name people use in the browser. With HTTPS, e.g.
# "https://competency.example.org". For HTTP-only local testing,
# "http://localhost" is enough.
CORS_ORIGINS=http://localhost,http://localhost:8066,http://127.0.0.1:8066
#CORS_ORIGINS=https://competency.example.org

# Session cookie — keep "false" while the site is HTTP-only. Flip to "true"
# once nginx serves HTTPS, then run `docker compose up -d` again.
SESSION_COOKIE_SECURE=false

# ── Behind an existing reverse proxy (optional) ─────────────────────────────
# Use these when another proxy on the host (e.g. the server's own nginx)
# already terminates TLS and forwards to this app. Start with:
#   docker compose -f docker-compose.yml -f docker-compose.external.yml up -d --build
# DOMAIN and LETSENCRYPT_EMAIL above are then not needed (certbot isn't started).
# Set CORS_ORIGINS to the public https:// origin and SESSION_COOKIE_SECURE=true;
# the proxy in front must send X-Forwarded-Proto.
#TLS_MODE=external
# The single host port the proxy in front forwards to.
#APP_PORT=8888

# Serve the app under a subpath instead of the domain root, e.g. "/wca"
# (no trailing slash). Works in every mode. Baked into the web build, so
# changing it needs `up -d --build`.
#BASE_PATH=
# Only with BASE_PATH: 301-redirect every other path on this host here, e.g.
# when an old domain that served the app at "/" now points at this server.
#ROOT_REDIRECT_URL=https://apps.example.org/wca

# Session lifetime in ms (default 8h).
SESSION_MAX_AGE_MS=28800000

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
