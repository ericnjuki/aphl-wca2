# Upstream API service (Docker Compose service name).
upstream api_upstream {
    server api:3000;
    keepalive 16;
}

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Serves only the ACME HTTP-01 challenge (for cert issuance + renewals).
# Everything else is redirected to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} ${DOMAIN_WWW};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN} ${DOMAIN_WWW};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # API reverse proxy — everything under {BASE_PATH}/api/ goes to the Node
    # service. proxy_pass's URI part strips whatever matched the location
    # prefix and replaces it with /api/, so the upstream always sees
    # /api/v1/... regardless of BASE_PATH (empty by default — root deploy).
    location ${BASE_PATH}/api/ {
        proxy_pass http://api_upstream/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Static assets — long cache with immutable hashes from Vite. `alias`
    # (not `root`) so the BASE_PATH prefix is dropped when mapping to disk.
    location ${BASE_PATH}/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Correct MIME for sqlite-wasm, at any prefix depth.
    location ~* ^${BASE_PATH}/(.*\.wasm)$ {
        alias /usr/share/nginx/html/$1;
        default_type application/wasm;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback — everything else serves index.html so React Router works.
    location ${BASE_PATH}/ {
        alias /usr/share/nginx/html/;
        index index.html;
        try_files $uri $uri/ ${BASE_PATH}/index.html;
    }

    # Optional root-path redirect — rendered only when BASE_PATH and
    # ROOT_REDIRECT_URL are both set (see docker-entrypoint script). Never
    # collides with the ${BASE_PATH}/ locations above since a bare "/"
    # request doesn't match a non-empty prefix.
    ROOT_REDIRECT_BLOCK

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json application/wasm
        image/svg+xml;
}
