{
  "name": "workforce-competency",
  "version": "1.0.0",
  "private": true,
  "description": "LabWorkforce — competency assessments for lab workforces. Monorepo (api + web).",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @workforce-competency/api run dev",
    "dev:web": "pnpm --filter @workforce-competency/web run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @workforce-competency/web run e2e",
    "e2e:ui": "pnpm --filter @workforce-competency/web run e2e:ui",
    "kill-dev": "pnpm --filter @workforce-competency/web run kill-dev",
    "clean": "turbo run clean && rimraf node_modules apps/*/node_modules apps/*/dist",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild"
    ]
  }
}
